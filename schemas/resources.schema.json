{
  "$ref": "#/definitions/DotagentsResourceManifestV2",
  "definitions": {
    "DotagentsResourceManifestV2": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "number",
          "const": 2
        },
        "resources": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "skill"
                  },
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                  },
                  "path": {
                    "type": "string"
                  },
                  "agents": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
                    },
                    "minItems": 1
                  }
                },
                "required": [
                  "kind",
                  "id",
                  "path"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "instruction"
                  },
                  "id": {
                    "$ref": "#/definitions/DotagentsResourceManifestV2/properties/resources/items/anyOf/0/properties/id"
                  },
                  "path": {
                    "$ref": "#/definitions/DotagentsResourceManifestV2/properties/resources/items/anyOf/0/properties/path"
                  },
                  "format": {
                    "type": "string",
                    "enum": [
                      "markdown",
                      "native"
                    ]
                  },
                  "activation": {
                    "type": "string",
                    "enum": [
                      "always",
                      "conditional"
                    ]
                  },
                  "condition": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                  },
                  "agents": {
                    "$ref": "#/definitions/DotagentsResourceManifestV2/properties/resources/items/anyOf/0/properties/agents"
                  }
                },
                "required": [
                  "kind",
                  "id",
                  "path",
                  "format",
                  "activation"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "command"
                  },
                  "id": {
                    "$ref": "#/definitions/DotagentsResourceManifestV2/properties/resources/items/anyOf/0/properties/id"
                  },
                  "path": {
                    "$ref": "#/definitions/DotagentsResourceManifestV2/properties/resources/items/anyOf/0/properties/path"
                  },
                  "format": {
                    "type": "string",
                    "enum": [
                      "markdown",
                      "yaml",
                      "json",
                      "native"
                    ]
                  },
                  "invocation": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9:_-]{0,127}$"
                  },
                  "agents": {
                    "$ref": "#/definitions/DotagentsResourceManifestV2/properties/resources/items/anyOf/0/properties/agents"
                  }
                },
                "required": [
                  "kind",
                  "id",
                  "path",
                  "format",
                  "invocation"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "subagent"
                  },
                  "id": {
                    "$ref": "#/definitions/DotagentsResourceManifestV2/properties/resources/items/anyOf/0/properties/id"
                  },
                  "path": {
                    "$ref": "#/definitions/DotagentsResourceManifestV2/properties/resources/items/anyOf/0/properties/path"
                  },
                  "format": {
                    "type": "string",
                    "enum": [
                      "markdown",
                      "yaml",
                      "json",
                      "toml",
                      "native"
                    ]
                  },
                  "role": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "agents": {
                    "$ref": "#/definitions/DotagentsResourceManifestV2/properties/resources/items/anyOf/0/properties/agents"
                  }
                },
                "required": [
                  "kind",
                  "id",
                  "path",
                  "format",
                  "role"
                ],
                "additionalProperties": false
              }
            ]
          },
          "maxItems": 10000
        }
      },
      "required": [
        "schema_version",
        "resources"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
