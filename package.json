{
  "name": "@beautyfree/dotagent",
  "version": "0.0.0",
  "description": "Canonical agent skill library engine and CLI",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/beautyfree/dotagent.git"
  },
  "homepage": "https://github.com/beautyfree/dotagent#readme",
  "bugs": {
    "url": "https://github.com/beautyfree/dotagent/issues"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "packageManager": "bun@1.3.14",
  "files": [
    "dist",
    "schemas",
    "README.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js"
    },
    "./library": {
      "types": "./dist/library.d.ts",
      "import": "./dist/library.js"
    },
    "./integrity": {
      "types": "./dist/integrity.d.ts",
      "import": "./dist/integrity.js"
    },
    "./inventory": {
      "types": "./dist/inventory.d.ts",
      "import": "./dist/inventory.js"
    },
    "./init": {
      "types": "./dist/init.d.ts",
      "import": "./dist/init.js"
    },
    "./import": {
      "types": "./dist/import.d.ts",
      "import": "./dist/import.js"
    },
    "./import-apply": {
      "types": "./dist/import-apply.d.ts",
      "import": "./dist/import-apply.js"
    },
    "./cli-import": {
      "types": "./dist/cli-import.d.ts",
      "import": "./dist/cli-import.js"
    },
    "./discovery": {
      "types": "./dist/discovery.d.ts",
      "import": "./dist/discovery.js"
    },
    "./adapters/skiller": {
      "types": "./dist/adapters/skiller.d.ts",
      "import": "./dist/adapters/skiller.js"
    },
    "./adapters/skills-cli": {
      "types": "./dist/adapters/skills-cli.d.ts",
      "import": "./dist/adapters/skills-cli.js"
    },
    "./adapters/skiller-agents": {
      "types": "./dist/adapters/skiller-agents.d.ts",
      "import": "./dist/adapters/skiller-agents.js"
    },
    "./audit": {
      "types": "./dist/audit.d.ts",
      "import": "./dist/audit.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js"
    },
    "./reconcile": {
      "types": "./dist/reconcile.d.ts",
      "import": "./dist/reconcile.js"
    },
    "./agents": {
      "types": "./dist/agents.d.ts",
      "import": "./dist/agents.js"
    },
    "./catalog": {
      "types": "./dist/catalog.d.ts",
      "import": "./dist/catalog.js"
    },
    "./schemas/skills.json": "./schemas/skills.schema.json",
    "./schemas/skills-lock.json": "./schemas/skills-lock.schema.json",
    "./schemas/dotagent.json": "./schemas/dotagent.schema.json",
    "./materialize": {
      "types": "./dist/materialize.d.ts",
      "import": "./dist/materialize.js"
    },
    "./prepared-library": {
      "types": "./dist/prepared-library.d.ts",
      "import": "./dist/prepared-library.js"
    },
    "./materialize-apply": {
      "types": "./dist/materialize-apply.d.ts",
      "import": "./dist/materialize-apply.js"
    },
    "./sources": {
      "types": "./dist/sources.d.ts",
      "import": "./dist/sources.js"
    },
    "./git-workspace": {
      "types": "./dist/git-workspace.d.ts",
      "import": "./dist/git-workspace.js"
    },
    "./machine": {
      "types": "./dist/machine.d.ts",
      "import": "./dist/machine.js"
    },
    "./doctor": {
      "types": "./dist/doctor.d.ts",
      "import": "./dist/doctor.js"
    },
    "./status": {
      "types": "./dist/status.d.ts",
      "import": "./dist/status.js"
    }
  },
  "bin": {
    "beautyfree-dotagent": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "biome lint src test scripts",
    "format": "biome format --write src test scripts *.json",
    "format:check": "biome format src test scripts *.json",
    "schema:generate": "bun run build && node scripts/generate-schemas.mjs --write",
    "schema:check": "bun run build && node scripts/generate-schemas.mjs --check",
    "check": "bun run lint && bun run format:check && bun run typecheck && bun test && bun run schema:check",
    "package:check": "bun run build && node scripts/verify-package.mjs",
    "ci": "bun run check && node dist/cli.js inspect fixtures/valid-library --json && node dist/cli.js audit fixtures/valid-library --public --json",
    "release:check": "bun run ci && bun run package:check"
  },
  "dependencies": {
    "yaml": "^2.8.3",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@types/bun": "^1.3.12",
    "@types/node": "^24.0.0",
    "typescript": "~5.8.3",
    "zod-to-json-schema": "^3.25.2"
  }
}
